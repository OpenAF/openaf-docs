          "old": "```javascript\nservices: { 'demo.Greeter': {\n  Watch: function(request, call, output) {\n    for (var i = 0; i < Number(request.count); i++) {\n      if (call.isCancelled()) return;\n      output.write({ name: String(i) });\n    }\n  },\n  Collect: function(input, call) {\n    var names = [];\n    while (true) {\n      var next = input.read();\n      if (next.done) break;\n      names.push(next.value.name);\n    }\n    return { name: names.join(',') };\n  },\n  Chat: function(stream, call) {\n    while (true) {\n      var next = stream.read();\n      if (next.done) return;\n      stream.write(next.value);\n    }\n  }\n} }",
          "new": "```javascript\nvar options = { services: { 'demo.Greeter': {\n  Watch: function(request, call, output) {\n    for (var i = 0; i < Number(request.count); i++) {\n      if (call.isCancelled()) return;\n      output.write({ name: String(i) });\n    }\n  },\n  Collect: function(input, call) {\n    var names = [];\n    while (true) {\n      var next = input.read();\n      if (next.done) break;\n      names.push(next.value.name);\n    }\n    return { name: names.join(',') };\n  },\n  Chat: function(stream, call) {\n    while (true) {\n      var next = stream.read();\n      if (next.done) return;\n      stream.write(next.value);\n    }\n  }\n} } };"
